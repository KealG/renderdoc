<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
	<mime-type type="@RDOC_MIME_TYPE@">
		<comment>@RDOC_PRODUCT_NAME@ capture file</comment>
		<magic priority="50">
			<match value="@RDOC_CAPTURE_MAGIC@" type="string" offset="0:4"/>
		</magic>
		<glob pattern="*.rdc"/>
	</mime-type>
</mime-info>
