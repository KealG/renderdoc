<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Branding">
    <RDOCBaseName>renderdoc</RDOCBaseName>
    <RDOCCoreTargetName>$(RDOCBaseName)</RDOCCoreTargetName>
    <RDOCCmdTargetName>renderdoccmd</RDOCCmdTargetName>
    <RDOCGuiTargetName>qrenderdoc</RDOCGuiTargetName>
    <RDOCGuiStubTargetName>renderdocui</RDOCGuiStubTargetName>
    <RDOCShimBaseTargetName>renderdocshim</RDOCShimBaseTargetName>
    <RDOCShim32TargetName>$(RDOCShimBaseTargetName)32</RDOCShim32TargetName>
    <RDOCShim64TargetName>$(RDOCShimBaseTargetName)64</RDOCShim64TargetName>
  </PropertyGroup>
</Project>
