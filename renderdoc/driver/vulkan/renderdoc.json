{
  "file_format_version" : "1.1.2",
  "layer" : {
    "name": "@VULKAN_LAYER_NAME@",
    "type": "GLOBAL",
    "library_path": "@VULKAN_LAYER_MODULE_PATH@",
    "api_version": "1.4.324",
    "implementation_version": "@RENDERDOC_VERSION_MINOR@",
    "description": "@VULKAN_LAYER_DESCRIPTION@",
    "functions": {
      "vkGetInstanceProcAddr": "@VULKAN_LAYER_GET_INSTANCE_PROC_ADDR@",
      "vkGetDeviceProcAddr": "@VULKAN_LAYER_GET_DEVICE_PROC_ADDR@",
      "vkNegotiateLoaderLayerInterfaceVersion": "@VULKAN_LAYER_NEGOTIATE_INTERFACE@"
    },
    "pre_instance_functions": {
      "vkEnumerateInstanceExtensionProperties": "@VULKAN_LAYER_ENUM_INSTANCE_EXT@"
    },
    "instance_extensions": [
      {
        "name": "VK_EXT_debug_utils",
        "spec_version": "1"
      }
    ],
    "device_extensions": [
      {
        "name": "VK_EXT_debug_marker",
        "spec_version": "4",
        "entrypoints": ["vkDebugMarkerSetObjectTagEXT",
                        "vkDebugMarkerSetObjectNameEXT",
                        "vkCmdDebugMarkerBeginEXT",
                        "vkCmdDebugMarkerEndEXT",
                        "vkCmdDebugMarkerInsertEXT"
                       ]
      },
      {
        "name": "VK_EXT_tooling_info",
        "spec_version": "1",
        "entrypoints": ["vkGetPhysicalDeviceToolPropertiesEXT"]
      }
    ],
    "enable_environment": {
      "@VULKAN_ENABLE_VAR@": "1"
    },
    "disable_environment": {
      "DISABLE_VULKAN_RENDERDOC_CAPTURE_@RENDERDOC_VERSION_MAJOR@_@RENDERDOC_VERSION_MINOR@": "1"
    }
  }
}
